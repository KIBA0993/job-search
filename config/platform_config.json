      "job_title_selector": "h2 a, h3 a, a[href*='/jobs/'], [class*='title'] a, [class*='Title'] a",
      "job_company_selector": "[class*='company'], [class*='Company'], [class*='employer']",
      "job_url_selector": "a[href*='/jobs/'], a[href*='/companies/']",
      "job_date_selector": "time, [class*='date'], [class*='Date']",
      "next_page_selector": ".ais-Pagination-item--nextPage a, button[class*='load'], a[rel='next']",
      "max_pages": 3,
      "page_load_wait_ms": 5000,
      "rate_limit_ms": 2000,
      "requires_login": false
