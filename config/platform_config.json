      "job_list_selector": "[data-testid='job-card'], article[class*='JobCard']",
      "job_title_selector": "h2, h3, [data-testid='job-title']",
      "job_company_selector": "[data-testid='company-name'], [class*='company']",
      "job_url_selector": "a[href*='/jobs/']",
      "job_date_selector": null,
      "next_page_selector": "[data-testid='load-more'], button[class*='load']",
      "max_pages": 3,
      "page_load_wait_ms": 5000,
      "rate_limit_ms": 2000,
      "requires_login": true
    },
    "workatstartup": {
      "enabled": true,
      "label": "Work at a Startup",
      "base_url": "https://www.workatastartup.com",
      "search_url": "https://www.workatastartup.com/jobs?query={title}&remote={remote}",
      "login_check_url": "https://www.workatastartup.com",
      "login_indicator_selector": "a[href='/user/settings']",
      "job_list_selector": "div[class*='job'] a[href*='/jobs/']",
      "job_title_selector": "h3, h2",
      "job_company_selector": "[class*='company']",
      "job_url_selector": "a[href*='/jobs/']",
      "job_date_selector": null,
      "next_page_selector": null,
      "max_pages": 1,
      "page_load_wait_ms": 5000,
      "rate_limit_ms": 2000,
      "requires_login": true
    },
    "underdog": {
      "enabled": true,
      "label": "Underdog.io",
      "base_url": "https://underdog.io",
      "search_url": "https://underdog.io/find-a-job",
