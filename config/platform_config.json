{
  "_comment": "Per-platform configuration for bb-browser adapters. Selectors updated as needed when platform UIs change.",
  "platforms": {
    "linkedin": {
      "enabled": true,
      "label": "LinkedIn",
      "base_url": "https://www.linkedin.com",
      "search_url": "https://www.linkedin.com/jobs/search/?keywords={title}&location={location}&f_TPR=r86400&sortBy=DD&f_SB2=5",
      "_comment_salary": "f_SB2=5 ≈ $160k+; f_SB2=6 ≈ $200k+. Salary URL param is a bracket, not exact.",
      "login_check_url": "https://www.linkedin.com/feed/",
      "login_indicator_selector": ".global-nav__me, [data-view-name='global-nav-me-photo']",
      "job_list_selector": ".jobs-search-results-list__list-item",
      "job_title_selector": ".job-card-list__title--link",
      "job_company_selector": ".job-card-container__primary-description",
      "job_url_selector": "a.job-card-list__title--link",
      "job_date_selector": "time",
      "next_page_selector": "button[aria-label='Next']",
      "easy_apply_indicator": ".jobs-apply-button--top-card span",
      "easy_apply_text": "Easy Apply",
      "max_pages": 5,
      "page_load_wait_ms": 4000,
      "rate_limit_ms": 2000,
      "requires_login": true
    },
    "indeed": {
      "enabled": true,
      "label": "Indeed",
      "base_url": "https://www.indeed.com",
      "search_url": "https://www.indeed.com/jobs?q={title}&l={location}&sort=date&fromage=1&sc=0kf%3Asal({salary_min}%2C)%3B",
      "_comment_salary": "sc=0kf:sal(180000,); is Indeed's salary facet filter (>= salary_min/yr)",
      "login_check_url": "https://www.indeed.com",
      "login_indicator_selector": "#indeed-ia",
      "job_list_selector": ".job_seen_beacon",
      "job_title_selector": "h2.jobTitle a",
      "job_company_selector": "[data-testid='company-name']",
      "job_url_selector": "h2.jobTitle a",
      "job_date_selector": "[data-testid='myJobsStateDate']",
      "next_page_selector": "a[data-testid='pagination-page-next']",
      "max_pages": 5,
      "page_load_wait_ms": 3000,
      "rate_limit_ms": 2000,
      "requires_login": false
    },
    "glassdoor": {
      "enabled": true,
      "label": "Glassdoor",
      "base_url": "https://www.glassdoor.com",
      "search_url": "https://www.glassdoor.com/Job/jobs.htm?sc.keyword={title}&locT=C&sortBy=date_desc&minSalary={salary_min}",
      "_comment_salary": "minSalary param filters by annual salary floor",
      "login_check_url": "https://www.glassdoor.com/member/home/index.htm",
      "login_indicator_selector": ".header_defaultHeader__userControls",
      "job_list_selector": "li[data-test='jobListing']",
      "job_title_selector": "a[data-test='job-title']",
      "job_company_selector": "[data-test='employer-name']",
      "job_url_selector": "a[data-test='job-title']",
      "job_date_selector": "[data-test='listed-age']",
      "next_page_selector": "button[data-test='pagination-next']",
      "max_pages": 5,
      "page_load_wait_ms": 4000,
      "rate_limit_ms": 3000,
      "requires_login": true
    },
    "ziprecruiter": {
      "enabled": true,
      "label": "ZipRecruiter",
      "base_url": "https://www.ziprecruiter.com",
      "search_url": "https://www.ziprecruiter.com/jobs-search?search={title}&location={location}&days=1&order_by=date&pay_gte={salary_min}",
      "_comment_salary": "pay_gte filters by minimum annual pay",
      "login_check_url": "https://www.ziprecruiter.com/candidate/dashboard",
      "login_indicator_selector": ".user_nav",
      "job_list_selector": "article[data-job-source]",
