      "enabled": true,
      "label": "Welcome to the Jungle",
      "base_url": "https://www.welcometothejungle.com",
      "search_url": "https://www.welcometothejungle.com/en/jobs?query={title}&refinementList%5Boffices.country_code%5D%5B%5D=US",
      "login_check_url": "https://www.welcometothejungle.com/en",
      "login_indicator_selector": "[data-testid='navbar-user-menu']",
      "job_list_selector": "li[data-testid='search-results-list-item-wrapper'], .ais-Hits-item, article[data-testid], [data-testid*='result-item']",
      "job_title_selector": "h3, h4, [data-testid*='title'], [class*='JobCard'] h3",
      "job_company_selector": "[data-testid*='company'], [class*='company'], [class*='Company']",
      "job_url_selector": "a[href*='/en/companies/'], a[href*='/jobs/']",
      "job_date_selector": "time",
      "next_page_selector": "a[data-testid='pagination-next'], [data-testid='pagination-next']",
      "max_pages": 5,
      "page_load_wait_ms": 5000,
      "rate_limit_ms": 2000,
      "requires_login": false
    }
